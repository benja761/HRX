--// FOV
local FOV = Drawing.new("Circle")
FOV.Color = THEME_COLOR
FOV.Thickness = 2
FOV.Filled = false
FOV.NumSides = 80

--// TARGET
local function getTarget()
	local best,dist=nil,math.huge
	local center=Cam.ViewportSize/2
	for _,p in pairs(Players:GetPlayers()) do
		if p~=lp and p.Character then
			if ignoreFriends and FriendsCache[p.UserId] then continue end
			local part=p.Character:FindFirstChild(aimPart)
			if part then
				local pos,vis=Cam:WorldToViewportPoint(part.Position)
				if vis then
					local d=(Vector2.new(pos.X,pos.Y)-center).Magnitude
					if d<dist and d<fovRadius then
						dist=d
						best=part
					end
				end
			end
		end
	end
	return best
end

--// INPUT
UIS.InputBegan:Connect(function(i,gp)
	if gp then return end

	if _G.toggleGuiKey and i.KeyCode==_G.toggleGuiKey then
		guiVisible=not guiVisible
		main.Visible=guiVisible
	end

	if _G.toggleFOVKey and i.KeyCode==_G.toggleFOVKey then
		fovVisible=not fovVisible
	end

	if _G.aimKey and (i.KeyCode==_G.aimKey or i.UserInputType==_G.aimKey) then
		aimEnabled=not aimEnabled
		if not aimEnabled then targetLocked=nil end
	end
end)

--// LOOP
RunService.RenderStepped:Connect(function()
	FOV.Position=Cam.ViewportSize/2
	FOV.Radius=fovRadius
	FOV.Visible=fovVisible

	if aimEnabled then
		if not targetLocked or not targetLocked.Parent then
			targetLocked=getTarget()
		end
		if targetLocked then
			local cf=Cam.CFrame
			local tcf=CFrame.lookAt(cf.Position,targetLocked.Position)
			Cam.CFrame=cf:Lerp(tcf,1-(smoothValue/15))
		end
	end
end)
