--// FRIEND CACHE
local FriendsCache = {}
local function loadFriends()
	table.clear(FriendsCache)
	local pages = Players:GetFriendsAsync(lp.UserId)
	while true do
		for _,info in pairs(pages:GetCurrentPage()) do
			FriendsCache[info.Id] = true
		end
		if pages.IsFinished then break end
		pages:AdvanceToNextPageAsync()
	end
end
